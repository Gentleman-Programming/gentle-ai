    "authority_applicability": {"$ref": "../../v1/schemas/failure.schema.json#/properties/authority_applicability"},
    "retry_safe": {"type": "boolean"},
    "replayability": {"$ref": "../../v1/schemas/failure.schema.json#/properties/replayability"},
