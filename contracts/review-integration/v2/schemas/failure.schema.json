    "target_identity": {"$ref": "../../v1/schemas/failure.schema.json#/properties/target_identity"},
        "request_digest": {"$ref": "../../v1/schemas/failure.schema.json#/properties/request_digest"},
    "progress_identity": {"$ref": "../../v1/schemas/failure.schema.json#/properties/progress_identity"},
    "required_inputs": {"$ref": "../../v1/schemas/failure.schema.json#/properties/required_inputs"},
    "next_action": {"$ref": "../../v1/schemas/failure.schema.json#/properties/next_action"},
    "cause_category": {"$ref": "../../v1/schemas/failure.schema.json#/properties/cause_category"},
    "cause": {"$ref": "../../v1/schemas/failure.schema.json#/properties/cause"},
    "context": {"$ref": "../../v1/schemas/failure.schema.json#/properties/context"}
