{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai.dev/contracts/review-integration/v2/schemas/last-event-closure.schema.json",
  "title": "Gentle AI review terminal last-event capture response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation", "lineage_id", "state", "store_revision"],
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "review.capture-correction-plan"}}, "required": ["operation"]},
      "then": {
        "required": ["target_identity", "request_hash", "correction_lines"],
        "not": {"required": ["action"]}
      },
      "else": {"required": ["action"]}
    },
    {
      "if": {"properties": {"operation": {"enum": ["review/capture-result", "review.capture-refuter"]}, "state": {"const": "correction_required"}}, "required": ["operation", "state"]},
      "then": {
        "required": ["status_continuation"],
        "properties": {
          "status_continuation": {
            "required": ["operation"],
            "properties": {"operation": {"const": "review.status"}}
          }
        }
      },
      "else": {"not": {"required": ["status_continuation"]}}
    },
    {
      "if": {"properties": {"state": {"const": "approved"}}, "required": ["state"]},
      "then": {"required": ["acknowledgement"]},
      "else": {"not": {"required": ["acknowledgement"]}}
    },
    {
      "if": {"required": ["targeted_validator_evidence"]},
      "then": {
        "properties": {
          "operation": {"const": "review/capture-validation"},
          "state": {"const": "escalated"}
        }
      }
    }
  ],
  "properties": {
    "schema": {"const": "gentle-ai.review-last-event-closure/v1"},
    "operation": {"enum": ["review/capture-result", "review.capture-correction-plan", "review.capture-refuter", "review/capture-validation"]},
    "lineage_id": {"type": "string", "minLength": 1},
    "target_identity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "request_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "correction_lines": {"type": "integer", "minimum": 1},
    "state": {"enum": ["approved", "correction_required", "escalated"]},
    "action": {"type": "string", "minLength": 1},
    "status_continuation": {"$ref": "transition-execution.schema.json#/$defs/last_event_status_execution"},
    "acknowledgement": {"$ref": "transition-execution.schema.json#/$defs/approved_acknowledgement_execution"},
    "store_revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "targeted_validator_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targeted_validation_request_hash", "correction_target_identity", "original_criteria", "correction_regression", "follow_ups"],
      "properties": {
        "targeted_validation_request_hash": {"$ref": "#/$defs/sha256"},
        "correction_target_identity": {"$ref": "#/$defs/sha256"},
        "original_criteria": {"$ref": "#/$defs/targeted_validator_check_evidence"},
        "correction_regression": {"$ref": "#/$defs/targeted_validator_check_evidence"},
        "follow_ups": {
          "type": "array",
          "items": {"$ref": "#/$defs/targeted_validator_follow_up"}
        }
      }
    },
    "advisory_findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "findings"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "severity", "disposition"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "lens": {"type": "string", "minLength": 1},
              "location": {"type": "string", "minLength": 1},
              "severity": {"type": "string", "minLength": 1},
              "disposition": {"enum": ["informational", "follow_up", "refuted"]}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "targeted_validator_check_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "evidence"],
      "properties": {
        "passed": {"type": "boolean"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "regressions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/targeted_validator_regression"}
        }
      }
    },
    "targeted_validator_regression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "claim", "proof_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "proof_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "targeted_validator_follow_up": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation", "proof_refs"],
      "properties": {
        "observation": {"type": "string", "minLength": 1},
        "proof_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
