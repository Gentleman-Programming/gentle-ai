{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai.dev/contracts/review-integration/v2/schemas/status-v6.schema.json",
  "title": "Gentle AI Review Integration native Git target status v6",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema", "contract", "operation", "applicability", "action", "replayability",
    "target_identity", "projection", "repair", "candidates"
  ],
  "properties": {
    "schema": {"const": "gentle-ai.review-integration.status/v6"},
    "contract": {"$ref": "status-v5.schema.json#/properties/contract"}, "operation": {"$ref": "status-v5.schema.json#/properties/operation"},
    "applicability": {"$ref": "status-v5.schema.json#/properties/applicability"}, "authority": {"$ref": "status-v5.schema.json#/properties/authority"},
    "action": {"$ref": "status-v5.schema.json#/properties/action"}, "action_disposition": {"$ref": "status-v5.schema.json#/properties/action_disposition"},
    "replayability": {"$ref": "status-v5.schema.json#/properties/replayability"}, "frozen": {"$ref": "status-v5.schema.json#/properties/frozen"},
    "target_identity": {"$ref": "status-v5.schema.json#/properties/target_identity"}, "authority_target_identity": {"$ref": "status-v5.schema.json#/properties/authority_target_identity"},
    "projection": {"$ref": "status-v5.schema.json#/properties/projection"}, "repair": {"$ref": "status-v5.schema.json#/properties/repair"},
    "candidates": {"$ref": "status-v5.schema.json#/properties/candidates"}, "reconciliation": {"$ref": "status-v5.schema.json#/properties/reconciliation"},
    "eligibility": {"$ref": "status-v5.schema.json#/properties/eligibility"}, "forecast": {"$ref": "status-v5.schema.json#/properties/forecast"},
    "next_transition": {"$ref": "#/$defs/next_transition"}, "validation_request": {"$ref": "status-v5.schema.json#/properties/validation_request"},
    "repository_context": {"$ref": "status-v5.schema.json#/properties/repository_context"}, "disposition": {"$ref": "status-v5.schema.json#/properties/disposition"}
  },
  "dependentRequired": {"forecast": ["next_transition"]},
  "$defs": {
    "next_transition": {"oneOf": [
      {"allOf": [
        {"$ref": "status-v5.schema.json#/$defs/next_transition"},
        {"not": {"properties": {"reason_code": {"const": "intended_untracked_selection_required"}}, "required": ["reason_code"]}}
      ]},
      {
        "type": "object", "additionalProperties": false, "required": ["kind", "reason_code", "collect"],
        "properties": {
          "kind": {"const": "collect"},
          "reason_code": {"const": "intended_untracked_selection_required"},
          "collect": {
            "type": "object", "additionalProperties": false, "required": ["inputs"],
            "properties": {"inputs": {
              "type": "array", "minItems": 1, "maxItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["name", "schema", "capture_operation", "arguments", "submission"],
                "properties": {
                  "name": {"const": "intended_untracked_selection"},
                  "schema": {"const": "gentle-ai.review-intended-untracked-selection/v1"},
                  "capture_operation": {"const": "external.select_intended_untracked"},
                  "arguments": {"type": "array", "minItems": 6, "maxItems": 6, "prefixItems": [
                    {"$ref": "#/$defs/contract_argument"}, {"$ref": "#/$defs/next_transition_argument"},
                    {"$ref": "#/$defs/agent_argument"}, {"$ref": "#/$defs/workspace_projection_argument"},
                    {"$ref": "#/$defs/eligible_paths_argument"}, {"$ref": "#/$defs/untracked_inventory_argument"}
                  ], "items": false},
                  "submission": {"$ref": "#/$defs/intended_untracked_submission"}
                }
              }
            }}
          }
        }
      }
    ]},
    "contract_argument": {"allOf": [{"$ref": "transition-execution.schema.json#/$defs/transition_argument"}, {"properties": {"name": {"const": "contract"}, "value": {"const": "gentle-ai.review-integration/v2"}}}]},
    "next_transition_argument": {"allOf": [{"$ref": "transition-execution.schema.json#/$defs/transition_argument"}, {"properties": {"name": {"const": "next-transition"}, "value": {"const": "true"}}}]},
    "agent_argument": {"allOf": [{"$ref": "transition-execution.schema.json#/$defs/transition_argument"}, {"properties": {"name": {"const": "agent"}, "value": {"pattern": "^\\S+$"}}}]},
    "workspace_projection_argument": {"allOf": [{"$ref": "transition-execution.schema.json#/$defs/transition_argument"}, {"properties": {"name": {"const": "projection"}, "value": {"const": "workspace"}}}]},
    "eligible_paths_argument": {"allOf": [{"$ref": "transition-execution.schema.json#/$defs/transition_argument"}, {"properties": {"name": {"const": "eligible_paths_json"}, "value": {"type": "string", "minLength": 1}}}]},
    "untracked_inventory_argument": {"allOf": [{"$ref": "transition-execution.schema.json#/$defs/transition_argument"}, {"properties": {"name": {"const": "expected_untracked_inventory"}, "value": {"$ref": "status-v5.schema.json#/$defs/sha256"}}}]},
    "intended_untracked_submission": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_token", "argument_tokens", "value"],
      "properties": {
        "operation_token": {"const": "status"},
        "argument_tokens": {"type": "array", "minItems": 5, "maxItems": 5, "prefixItems": [
          {"const": "--contract=gentle-ai.review-integration/v2"}, {"const": "--next-transition=true"},
          {"pattern": "^--agent=\\S+$"}, {"const": "--projection=workspace"},
          {"const": "--intended-untracked-selection={{value}}"}
        ], "items": false},
        "value": {
          "type": "object", "additionalProperties": false,
          "required": ["slot", "domain", "schema", "substitution_location"],
          "properties": {
            "slot": {"const": "intended_untracked_selection"}, "domain": {"const": "schema_bound_json"},
            "schema": {"const": "gentle-ai.review-intended-untracked-selection/v1"}, "substitution_location": {"const": 4}
          }
        }
      }
    }
  },
  "allOf": [
    {"$ref": "status-v5.schema.json#/allOf/0"}, {"$ref": "status-v5.schema.json#/allOf/1"},
    {"$ref": "status-v5.schema.json#/allOf/2"}, {"$ref": "status-v5.schema.json#/allOf/3"},
    {"$ref": "status-v5.schema.json#/allOf/4"}
  ]
}
