{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai.dev/contracts/review-integration/v2/schemas/status-v9.schema.json",
  "title": "Gentle AI Review Integration native Git target status v9",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema", "contract", "operation", "applicability", "action", "replayability",
    "target_identity", "projection", "repair", "candidates"
  ],
  "properties": {
    "schema": {"const": "gentle-ai.review-integration.status/v9"},
    "contract": {"$ref": "status-v8.schema.json#/properties/contract"}, "operation": {"$ref": "status-v8.schema.json#/properties/operation"},
    "applicability": {"$ref": "status-v8.schema.json#/properties/applicability"}, "authority": {"$ref": "status-v8.schema.json#/properties/authority"},
    "action": {"$ref": "status-v8.schema.json#/properties/action"}, "action_disposition": {"$ref": "status-v8.schema.json#/properties/action_disposition"},
    "replayability": {"$ref": "status-v8.schema.json#/properties/replayability"}, "frozen": {"$ref": "status-v8.schema.json#/properties/frozen"},
    "target_identity": {"$ref": "status-v8.schema.json#/properties/target_identity"}, "authority_target_identity": {"$ref": "status-v8.schema.json#/properties/authority_target_identity"},
    "projection": {"$ref": "status-v8.schema.json#/properties/projection"}, "repair": {"$ref": "status-v8.schema.json#/properties/repair"},
    "candidates": {"$ref": "status-v8.schema.json#/properties/candidates"}, "reconciliation": {"$ref": "status-v8.schema.json#/properties/reconciliation"},
    "eligibility": {"$ref": "status-v8.schema.json#/properties/eligibility"}, "forecast": {"$ref": "status-v8.schema.json#/properties/forecast"},
    "next_transition": {"$ref": "#/$defs/next_transition"}, "validation_request": {"$ref": "status-v8.schema.json#/properties/validation_request"},
    "repository_context": {"$ref": "status-v8.schema.json#/properties/repository_context"}, "disposition": {"$ref": "status-v8.schema.json#/properties/disposition"},
    "eligible_untracked_inventory": {"$ref": "status-v8.schema.json#/properties/eligible_untracked_inventory"},
    "escalation": {"$ref": "status-v8.schema.json#/properties/escalation"},
    "non_blocking_findings": {"$ref": "#/$defs/non_blocking_findings"}
  },
  "dependentRequired": {"forecast": ["next_transition"]},
  "$defs": {
    "non_blocking_findings": {
      "description": "Opt-in (--non-blocking-findings): the admitted findings of a correction_required or escalated review that are neither to correct nor unresolved.",
      "type": "object", "additionalProperties": false, "required": ["statement", "findings"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "findings": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "severity", "disposition", "claim"],
          "properties": {
            "id": {"type": "string", "minLength": 1}, "lens": {"type": "string", "minLength": 1},
            "location": {"type": "string", "minLength": 1}, "severity": {"type": "string", "minLength": 1},
            "disposition": {"enum": ["informational", "follow_up", "refuted"]}, "claim": {"type": "string"}
          }
        }}
      }
    },
    "next_transition": {"oneOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reason_code",
          "continuation"
        ],
        "properties": {
          "kind": {
            "const": "stop"
          },
          "reason_code": {
            "enum": [
              "correction_request_unavailable",
              "correction_context_budget_exceeded"
            ]
          },
          "continuation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "command",
              "detail"
            ],
            "properties": {
              "operation": {
                "const": "abandon"
              },
              "command": {
                "type": "string",
                "pattern": "^(?:[A-Za-z0-9/._+=@:,-]+|\"(?:[^\"\\\\\\r\\n]|\\\\[^\\r\\n])*\"|'(?:[^'\\r\\n]|'\\\\'')*') review abandon --cwd (?:[A-Za-z0-9/._+=@:,-]+|\"(?:[^\"\\\\\\r\\n]|\\\\[^\\r\\n])*\"|'(?:[^'\\r\\n]|'\\\\'')*')$"
              },
              "detail": {
                "type": "string",
                "pattern": "[^\t-\r \u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]"
              },
              "agent": {
                "type": "string"
              }
            }
          }
        }
      },
      {"allOf": [
        {"$ref": "status-v8.schema.json#/$defs/next_transition"},
        {"not": {"properties": {"reason_code": {"enum": [
          "provider_refuter_required", "targeted_validation_required", "targeted_validation_inconclusive_recapture_required",
          "intended_untracked_selection_required"
        ]}}, "required": ["reason_code"]}}
      ]},
      {
        "type": "object", "additionalProperties": false, "required": ["kind", "reason_code", "collect"],
        "properties": {
          "kind": {"const": "collect"},
          "reason_code": {"const": "provider_refuter_required"},
          "collect": {
            "type": "object", "additionalProperties": false, "required": ["inputs"],
            "properties": {"inputs": {
              "type": "array", "minItems": 1, "maxItems": 1,
              "items": {"oneOf": [
                {"$ref": "status-v5.schema.json#/$defs/transition_input"},
                {"$ref": "#/$defs/provider_role_submission_input"}
              ]}
            }}
          }
        }
      },
      {
        "type": "object", "additionalProperties": false, "required": ["kind", "reason_code", "collect"],
        "properties": {
          "kind": {"const": "collect"},
          "reason_code": {"enum": ["targeted_validation_required", "targeted_validation_inconclusive_recapture_required"]},
          "collect": {
            "type": "object", "additionalProperties": false, "required": ["inputs"],
            "properties": {"inputs": {
              "type": "array", "minItems": 1, "maxItems": 1,
              "items": {"oneOf": [
                {"$ref": "status-v5.schema.json#/$defs/transition_input"},
                {"$ref": "#/$defs/provider_role_submission_input"}
              ]}
            }}
          }
        },
        "allOf": [
          {
            "if": {"properties": {"reason_code": {"const": "targeted_validation_required"}}, "required": ["reason_code"]},
            "then": {"properties": {"collect": {"properties": {"inputs": {"items": {"anyOf": [
              {"properties": {"capture_operation": {"const": "external.run_targeted_validation"}}, "required": ["capture_operation", "submission"]},
              {"properties": {"capture_operation": {"const": "external.run_provider_role"}}, "required": ["capture_operation", "provider_task"]},
              {"properties": {"capture_operation": {"const": "review.capture-validation"}}, "required": ["capture_operation", "validation_request"]}
            ]}}}}}}
          }
        ]
      },
      {"$ref": "#/$defs/intended_untracked_selection_required"}
    ]},
    "intended_untracked_selection_required": {
      "description": "Typed untracked-declaration collect. STATUS without a runtime agent uses the manual form with no submission. Named runtimes without the exact bound-selection opt-in still receive the historical unbound submission, even when STATUS has a bound lineage. For manual selection, rerun the same bound STATUS with --untracked-scope and --expected-untracked-inventory, plus --intended-untracked for each selected path.",
      "type": "object", "additionalProperties": false, "required": ["kind", "reason_code", "collect"],
      "properties": {
        "kind": {"const": "collect"}, "reason_code": {"const": "intended_untracked_selection_required"},
        "collect": {"type": "object", "additionalProperties": false, "required": ["inputs"], "properties": {"inputs": {
          "type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/intended_untracked_selection_input"}
        }}}
      }
    },
    "intended_untracked_selection_input": {
      "type": "object", "additionalProperties": false, "required": ["name", "schema", "capture_operation", "arguments"],
      "properties": {
        "name": {"const": "intended_untracked_selection"},
        "schema": {"const": "gentle-ai.review-intended-untracked-selection/v1"},
        "capture_operation": {"const": "external.select_intended_untracked"},
        "arguments": {"type": "array", "minItems": 6, "maxItems": 6, "items": false, "prefixItems": [
          {"allOf": [{"$ref": "transition-execution.schema.json#/$defs/transition_argument"}, {"properties": {"name": {"const": "target_identity"}, "value": {"$ref": "transition-binding.schema.json#/$defs/sha256"}}}]},
          {"allOf": [{"$ref": "transition-execution.schema.json#/$defs/transition_argument"}, {"properties": {"name": {"const": "projection"}, "value": {"enum": ["workspace", "staged"]}}}]},
          {"allOf": [{"$ref": "transition-execution.schema.json#/$defs/transition_argument"}, {"properties": {"name": {"const": "base_tree"}}}]},
          {"allOf": [{"$ref": "transition-execution.schema.json#/$defs/transition_argument"}, {"properties": {"name": {"const": "candidate_tree"}}}]},
          {"allOf": [{"$ref": "transition-execution.schema.json#/$defs/transition_argument"}, {"properties": {"name": {"const": "eligible_paths_json"}}}]},
          {"allOf": [{"$ref": "transition-execution.schema.json#/$defs/transition_argument"}, {"properties": {"name": {"const": "expected_untracked_inventory"}, "value": {"$ref": "status-v5.schema.json#/$defs/sha256"}}}]}
        ]},
        "submission": {"$ref": "#/$defs/intended_untracked_submission"}
      }
    },
    "intended_untracked_submission": {
      "description": "STATUS v9 accepts the union of negotiated forms. The historical unbound tuples (workspace or base-ref, substitution at index 4 or 5) preserve decoding compatibility, not bound replay. Only STATUS run with the exact process environment GENTLE_AI_BOUND_SELECTION_CONTRACT=gentle-ai.review-bound-selection/v1 can emit a bound tuple. It carries the explicitly requested --lineage at index 3, matching authority.lineage_id, and substitutes at index 5 or 6. Accept the bound tuple only if that STATUS call opted in and the lineage matches. Replay in the same repository, replacing only the final JSON value; do not infer lineage or retry a bound selection with unbound tokens. The answer needs no environment opt-in.",
      "oneOf": [
        {"$ref": "#/$defs/intended_untracked_submission_form", "properties": {"argument_tokens": {"minItems": 5, "maxItems": 5, "prefixItems": [{}, {}, {}, {"const": "--projection=workspace"}, {"const": "--intended-untracked-selection={{value}}"}]}, "value": {"properties": {"substitution_location": {"const": 4}}}}},
        {"$ref": "#/$defs/intended_untracked_submission_form", "properties": {"argument_tokens": {"minItems": 6, "maxItems": 6, "prefixItems": [{}, {}, {}, {"$ref": "#/$defs/intended_untracked_base_ref_token"}, {"$ref": "#/$defs/intended_untracked_base_scope_token"}, {"const": "--intended-untracked-selection={{value}}"}]}, "value": {"properties": {"substitution_location": {"const": 5}}}}},
        {"$ref": "#/$defs/intended_untracked_submission_form", "properties": {"argument_tokens": {"minItems": 6, "maxItems": 6, "prefixItems": [{}, {}, {}, {"$ref": "#/$defs/intended_untracked_lineage_token"}, {"const": "--projection=workspace"}, {"const": "--intended-untracked-selection={{value}}"}]}, "value": {"properties": {"substitution_location": {"const": 5}}}}},
        {"$ref": "#/$defs/intended_untracked_submission_form", "properties": {"argument_tokens": {"minItems": 7, "maxItems": 7, "prefixItems": [{}, {}, {}, {"$ref": "#/$defs/intended_untracked_lineage_token"}, {"$ref": "#/$defs/intended_untracked_base_ref_token"}, {"$ref": "#/$defs/intended_untracked_base_scope_token"}, {"const": "--intended-untracked-selection={{value}}"}]}, "value": {"properties": {"substitution_location": {"const": 6}}}}}
      ]
    },
    "intended_untracked_base_ref_token": {"pattern": "^--base-ref=[0-9a-f]{40}(?:[0-9a-f]{24})?$"},
    "intended_untracked_base_scope_token": {"enum": ["--committed-only=true", "--workspace-overlay=true"]},
    "intended_untracked_lineage_token": {"pattern": "^--lineage=[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 138},
    "intended_untracked_submission_form": {
      "type": "object", "additionalProperties": false, "required": ["operation_token", "argument_tokens", "value"],
      "properties": {
        "operation_token": {"const": "status"},
        "argument_tokens": {"type": "array", "prefixItems": [
          {"const": "--contract=gentle-ai.review-integration/v2"}, {"const": "--next-transition=true"}, {"pattern": "^--agent=\\S+$"}
        ]},
        "value": {"type": "object", "additionalProperties": false, "required": ["slot", "domain", "schema", "substitution_location"], "properties": {
          "slot": {"const": "intended_untracked_selection"}, "domain": {"const": "schema_bound_json"},
          "schema": {"const": "gentle-ai.review-intended-untracked-selection/v1"}, "substitution_location": {"type": "integer"}
        }}
      }
    },
    "provider_role_submission_input": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "schema", "capture_operation", "arguments", "submission"],
      "properties": {
        "name": {"enum": ["provider_refuter", "provider_targeted_validator"]},
        "schema": {"enum": [
          "https://gentle-ai.dev/schema/review/refuter/v1",
          "https://gentle-ai.dev/schema/review/validator/v1"
        ]},
        "capture_operation": {"enum": ["review.capture-refuter", "review.capture-validation"]},
        "arguments": {"type": "array", "minItems": 1, "items": {"$ref": "transition-execution.schema.json#/$defs/transition_argument"}},
        "validation_request": {"$ref": "../../v1/schemas/targeted-validation-request.schema.json"},
        "submission": {"$ref": "#/$defs/provider_role_submission_descriptor"}
      },
      "allOf": [
        {
          "if": {"properties": {"capture_operation": {"const": "review.capture-validation"}}, "required": ["capture_operation"]},
          "then": {"required": ["validation_request"]},
          "else": {"not": {"required": ["validation_request"]}}
        }
      ]
    },
    "provider_role_submission_descriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_token", "argument_tokens", "value"],
      "properties": {
        "operation_token": {"enum": ["capture-refuter", "capture-validation"]},
        "argument_tokens": {"type": "array", "items": {"type": "string", "pattern": "^--\\S+=\\S+$"}},
        "value": {
          "type": "object", "additionalProperties": false,
          "required": ["slot", "domain", "schema", "substitution_location"],
          "properties": {
            "slot": {"enum": ["provider_refuter", "provider_targeted_validator"]},
            "domain": {"const": "artifact_path_or_stdin"},
            "schema": {"enum": [
              "https://gentle-ai.dev/schema/review/refuter/v1",
              "https://gentle-ai.dev/schema/review/validator/v1"
            ]},
            "substitution_location": {"type": "integer", "minimum": 0}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"operation_token": {"const": "capture-refuter"}}, "required": ["operation_token"]},
          "then": {
            "properties": {
              "argument_tokens": {"minItems": 6, "maxItems": 6, "prefixItems": [
                {"pattern": "^--lineage=\\S+$"},
                {"pattern": "^--expected-revision=sha256:[0-9a-f]{64}$"},
                {"pattern": "^--target=sha256:[0-9a-f]{64}$"},
                {"pattern": "^--repository-context=(?:rctx[12]_[0-9a-f]{64}|rctx3_[A-Za-z0-9_-]{82,})$", "maxLength": 5569},
                {"pattern": "^--agent=\\S+$"},
                {"const": "--input={{value}}"}
              ], "items": false},
              "value": {"properties": {"slot": {"const": "provider_refuter"}, "schema": {"const": "https://gentle-ai.dev/schema/review/refuter/v1"}, "substitution_location": {"const": 5}}}
            }
          }
        },
        {
          "if": {"properties": {"operation_token": {"const": "capture-validation"}}, "required": ["operation_token"]},
          "then": {
            "properties": {
              "argument_tokens": {"minItems": 7, "maxItems": 7, "prefixItems": [
                {"pattern": "^--lineage=\\S+$"},
                {"pattern": "^--expected-revision=sha256:[0-9a-f]{64}$"},
                {"pattern": "^--target=sha256:[0-9a-f]{64}$"},
                {"pattern": "^--repository-context=(?:rctx[12]_[0-9a-f]{64}|rctx3_[A-Za-z0-9_-]{82,})$", "maxLength": 5569},
                {"pattern": "^--request-hash=sha256:[0-9a-f]{64}$"},
                {"pattern": "^--agent=\\S+$"},
                {"const": "--input={{value}}"}
              ], "items": false},
              "value": {"properties": {"slot": {"const": "provider_targeted_validator"}, "schema": {"const": "https://gentle-ai.dev/schema/review/validator/v1"}, "substitution_location": {"const": 6}}}
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {"$ref": "status-v8.schema.json#/allOf/0"}, {"$ref": "status-v8.schema.json#/allOf/1"},
    {"$ref": "status-v8.schema.json#/allOf/2"}, {"$ref": "status-v8.schema.json#/allOf/3"},
    {"$ref": "status-v8.schema.json#/allOf/4"}, {"$ref": "status-v8.schema.json#/allOf/5"},
    {"if": {"required": ["non_blocking_findings"]}, "then": {"required": ["authority"], "properties": {"authority": {"properties": {
      "version": {"const": "compact-v2"}, "state": {"enum": ["correction_required", "escalated"]}
    }, "required": ["version", "state"]}}}}
  ]
}
