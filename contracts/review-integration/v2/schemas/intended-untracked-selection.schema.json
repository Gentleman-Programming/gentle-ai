{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gentle-ai.review-intended-untracked-selection/v1",
  "title": "Gentle AI intended untracked selection",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "untracked_scope", "expected_untracked_inventory", "intended_untracked"],
  "properties": {
    "schema": {"const": "gentle-ai.review-intended-untracked-selection/v1"},
    "untracked_scope": {"enum": ["exclude", "select"]},
    "expected_untracked_inventory": {"$ref": "status-v5.schema.json#/$defs/sha256"},
    "intended_untracked": {"type": "array", "uniqueItems": true, "items": {"$ref": "start.schema.json#/$defs/changed_path"}}
  },
  "allOf": [
    {"if": {"properties": {"untracked_scope": {"const": "exclude"}}, "required": ["untracked_scope"]}, "then": {"properties": {"intended_untracked": {"maxItems": 0}}}},
    {"if": {"properties": {"untracked_scope": {"const": "select"}}, "required": ["untracked_scope"]}, "then": {"properties": {"intended_untracked": {"minItems": 1}}}}
  ]
}
