{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai.dev/contracts/review-integration/v1/schemas/capabilities-v1.5.schema.json",
  "title": "Gentle AI review integration capabilities protocol 1.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract",
    "protocol",
    "package",
    "build",
    "executable",
    "operations",
    "gates",
    "projections",
    "schemas",
    "features",
    "compatibility"
  ],
  "properties": {
    "schema": {
      "const": "gentle-ai.review-integration.capabilities/v1.5"
    },
    "contract": {
      "$ref": "capabilities-v1.4.schema.json#/properties/contract"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": {"const": 1},
        "minor": {"const": 5}
      }
    },
    "package": {
      "$ref": "capabilities-v1.4.schema.json#/properties/package"
    },
    "build": {
      "$ref": "capabilities-v1.4.schema.json#/properties/build"
    },
    "executable": {
      "$ref": "capabilities-v1.4.schema.json#/properties/executable"
    },
    "operations": {
      "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
      "items": {"enum": ["review.capabilities", "review.repair", "review.start", "review.status", "review.validate"]}
    },
    "gates": {
      "$ref": "capabilities-v1.4.schema.json#/properties/gates"
    },
    "projections": {
      "$ref": "capabilities-v1.4.schema.json#/properties/projections"
    },
    "schemas": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "uniqueItems": true,
      "items": {
        "enum": [
          "gentle-ai.review-admitted-result/v1",
          "gentle-ai.review-artifact-subject/v1",
          "gentle-ai.review-authority-repair-assessment/v1",
          "gentle-ai.review-authority-status/v1",
          "gentle-ai.review-gate-request/v1",
          "gentle-ai.review-integration.capabilities/v1.5",
          "gentle-ai.review-integration.failure/v1",
          "gentle-ai.review-integration.operation/v1",
          "gentle-ai.review-integration.projection/v1",
          "gentle-ai.review-integration.repair/v1",
          "gentle-ai.review-integration.start/v2",
          "gentle-ai.review-integration.status/v2",
          "gentle-ai.review-receipt/v1",
          "gentle-ai.review-receipt/v2",
          "gentle-ai.review-result-artifact/v2",
          "gentle-ai.review-targeted-validation-request/v1",
          "https://gentle-ai.dev/schema/review/refuter/v1",
          "https://gentle-ai.dev/schema/review/reviewer/v1",
          "https://gentle-ai.dev/schema/review/validator/v1"
        ]
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mandatory", "optional"],
      "properties": {
        "mandatory": {
          "type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/feature"}
        },
        "optional": {
          "type": "array", "minItems": 13, "maxItems": 13, "items": {"$ref": "#/$defs/feature"}
        }
      }
    },
    "bootstrap": {
      "$ref": "capabilities-v1.4.schema.json#/properties/bootstrap"
    },
    "compatibility": {
      "$ref": "capabilities-v1.4.schema.json#/properties/compatibility"
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "supported", "requires"],
      "properties": {
        "name": {
          "enum": [
            "base_ref_workspace_overlay",
            "bounded_process_waits",
            "classified_authority_repair",
            "compact_v2_authority",
            "immutable_snapshot",
            "legacy_v1_target_scoped_read_only",
            "native_frozen_candidate_context",
            "native_low_risk_verification",
            "native_next_transition",
            "opaque_repository_context",
            "provider_artifact_admission",
            "provider_targeted_validation_request",
            "recovered_correction_evidence",
            "repository_independent_capabilities",
            "restart_safe_projection",
            "risk_reasons",
            "scope_change_diagnostics",
            "sdd_receipt_binding",
            "target_scoped_status",
            "uniform_failure_envelope",
            "validating_result_reopen"
          ]
        },
        "supported": {"type": "boolean"},
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
