{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai.dev/audits/data/organic-rdd-recovery/schemas/invariant-ledger.schema.json",
  "title": "Organic RDD recovery invariant ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invariants"
  ],
  "properties": {
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context",
          "invariant",
          "path",
          "proof"
        ],
        "properties": {
          "context": {"$ref": "#/$defs/context"},
          "invariant": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "proof": {"$ref": "#/$defs/proof"}
        }
      }
    }
  },
  "$defs": {
    "context": {
      "enum": ["HCR", "MMI", "ACI", "MCA", "RAR", "EPD", "DSR", "SDD", "PAD"]
    },
    "proof": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
