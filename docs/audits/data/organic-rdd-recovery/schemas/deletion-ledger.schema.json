{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentle-ai.dev/audits/data/organic-rdd-recovery/schemas/deletion-ledger.schema.json",
  "title": "Organic RDD recovery deletion ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deletions"
  ],
  "properties": {
    "deletions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "earlyDeviation",
          "noRetainedInvariant",
          "path",
          "publication"
        ],
        "properties": {
          "destinationPath": {"type": "string", "minLength": 1},
          "destinationProof": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "earlyDeviation": {"type": "boolean"},
          "noRetainedInvariant": {"type": "boolean"},
          "path": {"type": "string", "minLength": 1},
          "publication": {"$ref": "#/$defs/publication"}
        }
      }
    }
  },
  "$defs": {
    "publication": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "present",
          "ref"
        ],
        "properties": {
          "present": {"type": "boolean"},
          "ref": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
